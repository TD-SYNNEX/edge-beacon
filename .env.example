# Keep credentials on the server. Never put them in public/ or browser storage.
# Jev (TypeSafe System One) powers Ask Beacon, matching, inbox triage,
# approval gating, lab grading and opportunity checks. Disabled until a key is set.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
JEV_ENABLED=false
# Optional: OpenAI drafts discovery summaries when Jev is off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_ENABLED=false

# Cognito sign-in. Required — the whole workspace is gated behind it.
# Same one pool for local dev and prod; get these from the deployed
# infra/ stack's CfnOutputs (or `cdk deploy` output). None of these three
# are secrets, but the browser only reads the VITE_-prefixed copies.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=
# Set only by the deployed Lambda (via CDK); leave unset locally so the
# server keeps reading OPENAI_API_KEY/TYPESAFE_API_KEY from this file.
SECRETS_ARN=
# Test-only. Never set this in a deployed environment.
AUTH_TEST_MODE=false
