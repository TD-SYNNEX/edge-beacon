# Keep credentials on the server. Never put them in public/ or browser storage.
# Jev (TypeSafe System One) powers Ask Beacon, matching, inbox triage,
# approval gating, lab grading and opportunity checks. Disabled until a key is set.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
JEV_ENABLED=false
# Optional: OpenAI drafts discovery summaries when Jev is off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_ENABLED=false
