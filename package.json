{
  "name": "edge-beacon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsx scripts/build.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "start": "tsx scripts/serve.ts",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "lucide": "^1.46.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
